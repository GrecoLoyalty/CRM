# Copia este archivo a .env.local y completa con tus valores de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tuproyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# Clave secreta para cifrar/descifrar la bóveda de contraseñas (AES vía pgcrypto)
# Genera una con: openssl rand -base64 32
VAULT_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Envío de correos (invitaciones del calendario compartido) vía Resend.
# Sin estas dos variables, el CRM sigue funcionando normal: solo no se
# enviará el correo (la notificación dentro del CRM sí llega siempre).
# Crea una cuenta gratis en https://resend.com para obtener tu API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="GRESANOVA OS <notificaciones@tudominio.com>"

# Integración con Google (Gmail + Calendar), conexión personal por usuario.
# Sin estas variables, la pantalla de Integraciones sigue existiendo pero
# avisa que la integración no está configurada. Guía completa: GOOGLE_SETUP.md
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Usada también para cifrar el refresh_token de Google (reutiliza VAULT_SECRET_KEY de arriba)
